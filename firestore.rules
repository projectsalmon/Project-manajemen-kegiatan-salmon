rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Periksa apakah pengguna terautentikasi
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Periksa apakah pengguna adalah Administrator / Staf Kelurahan
    function isAdmin() {
      return isAuthenticated() && (
        ('email' in request.auth.token && request.auth.token.email != null && (
          request.auth.token.email.lower() == 'salmanakhdanhidayat@gmail.com' ||
          request.auth.token.email.lower() == 'ytsalmon37@gmail.com'
        )) ||
        ('role' in request.auth.token && request.auth.token.role == 'admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userRole', '') == 'STAF_KELURAHAN'
        ))
      );
    }

    // Helper: Periksa apakah pengguna adalah Pengurus RW
    function isRW() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userRole', '') == 'RW'
        ))
      );
    }

    // Helper: Periksa apakah pengguna adalah pemilik data (Owner)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Aturan untuk Pengaturan Aplikasi / Identitas Kelurahan (/settings/{docId})
    match /settings/{docId} {
      // Semua pengguna (termasuk publik/tamu) dapat membaca nama aplikasi & wilayah kelurahan
      allow read: if true;
      // Hanya Admin/Staf Kelurahan yang dapat mengubah konfigurasi identitas wilayah
      allow write: if isAdmin();
    }

    // Aturan untuk Koleksi Pengguna (/users/{userId})
    match /users/{userId} {
      // Pengguna terautentikasi dapat membaca direktori akun warga, Admin dapat membaca semua
      allow read: if isAuthenticated();
      
      // Pengguna dapat memperbarui profilnya sendiri, Admin memiliki hak penuh
      allow write: if isAuthenticated() && (
        isAdmin() || isOwner(userId)
      );
    }

    // Aturan untuk Koleksi Kegiatan (/activities/{activityId})
    match /activities/{activityId} {
      // Semua pengguna (publik & terautentikasi) dapat membaca kegiatan
      allow read: if true;

      // Pengguna terautentikasi dapat membuat kegiatan atau melakukan seeding awal
      allow create: if isAuthenticated();

      // Pengguna terautentikasi dapat memperbarui kegiatan:
      // - Admin/Staf Kelurahan: persetujuan akhir & kelola seluruh kegiatan
      // - Pengurus RW: approval usulan RT
      // - Pemilik Kegiatan: edit detail kegiatan miliknya
      // - Warga: konfirmasi kehadiran / partisipasi (RSVP)
      allow update: if isAuthenticated();

      // Hanya Admin atau pemilik kegiatan yang dapat menghapus kegiatan
      allow delete: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid ||
        ('email' in request.auth.token && resource.data.creatorEmail == request.auth.token.email)
      );
    }

    // Aturan untuk Koleksi Pengumuman (/announcements/{announcementId})
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isAdmin() || isRW());
    }

    // Aturan untuk Kontak Penting (/contacts/{contactId})
    match /contacts/{contactId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin();
    }
  }
}

