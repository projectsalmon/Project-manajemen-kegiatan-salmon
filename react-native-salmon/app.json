{
  "expo": {
    "name": "Komuniva",
    "slug": "komuniva-app",
    "version": "2.0.3",
    "orientation": "portrait",
    "scheme": "com.salmon.app",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#081B38"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#081B38"
      },
      "package": "com.salmon.app"
    },
    "extra": {
      "eas": {
        "projectId": "a3eb15e8-d14d-46c8-9a76-b96e4748a4e1"
      }
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0369A1",
          "defaultChannel": "kegiatan-kelurahan-notif"
        }
      ]
    ]
  }
}
