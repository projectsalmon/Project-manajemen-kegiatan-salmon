{
  "expo": {
    "name": "Kegiatan Kelurahan",
    "slug": "project-manajemen-kegiatan-salmon",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "com.salmon.app",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#0369A1"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0369A1"
      },
      "package": "com.salmon.app"
    },
    "extra": {
      "eas": {
        "projectId": "a3eb15e8-d14d-46c8-9a76-b96e4748a4e1"
      }
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ]
  }
}
